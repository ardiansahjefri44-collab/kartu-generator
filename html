// PRINT SETUP & HIGH-DPI PDF EXPORT VIEW COMPONENT
function PrintSetupView({ cardDesign, students, renderPlaceholderText, addNotification, isDarkMode }) {
  const [paperSize, setPaperSize] = useState('a4');
  const [customWidthMm, setCustomWidthMm] = useState(210);
  const [customHeightMm, setCustomHeightMm] = useState(297);
  const [marginTopMm, setMarginTopMm] = useState(10);
  const [marginLeftMm, setMarginLeftMm] = useState(10);
  const [gapXMm, setGapXMm] = useState(4);
  const [gapYMm, setGapYMm] = useState(4);
  const [cols, setCols] = useState(2);
  const [rows, setRows] = useState(5);
  const [gridAlign, setGridAlign] = useState('center');
  const [offsetX, setOffsetX] = useState(0);
  const [offsetY, setOffsetY] = useState(0);
  const [showCropMarks, setShowCropMarks] = useState(true);
  const [activePreviewPage, setActivePreviewPage] = useState(0);
  const [isExporting, setIsExporting] = useState(false);

  // Paper Dimensions calculation in mm
  const getPaperDimensions = () => {
    if (paperSize === 'a4') return { w: 210, h: 297 };
    if (paperSize === 'letter') return { w: 216, h: 279 };
    if (paperSize === 'f4') return { w: 215, h: 330 };
    return { w: Number(customWidthMm) || 210, h: Number(customHeightMm) || 297 };
  };

  const currentPaper = getPaperDimensions();
  const cardsPerPage = Math.max(1, cols * rows);
  const totalPages = Math.ceil(students.length / cardsPerPage) || 1;
  const currentPageStudents = students.slice(
    activePreviewPage * cardsPerPage,
    (activePreviewPage + 1) * cardsPerPage
  );

  // Scale factor to display paper nicely inside preview container (e.g. 2.2px per mm)
  const previewScale = 2.0;

  // Calculate start positions with offset & alignment
  const totalGridWidth = cols * cardDesign.widthMm + (cols - 1) * gapXMm;
  const computedMarginLeft =
    gridAlign === 'center'
      ? (currentPaper.w - totalGridWidth) / 2 + Number(offsetX)
      : Number(marginLeftMm) + Number(offsetX);
  const computedMarginTop = Number(marginTopMm) + Number(offsetY);

  // Direct Browser Print Function
  const handleDirectPrint = () => {
    window.print();
  };

  const exportPDF = async () => {
    if (!window.jspdf || !window.html2canvas) {
      addNotification('Library PDF sedang memuat, silakan tunggu sebentar...', 'error');
      return;
    }

    setIsExporting(true);
    addNotification('Sedang membuat berkas PDF High-DPI Siap Cetak...', 'info');

    try {
      const { jsPDF } = window.jspdf;
      const paperW = Number(currentPaper.w) || 210;
      const paperH = Number(currentPaper.h) || 297;

      const pdf = new jsPDF({
        orientation: paperW > paperH ? 'l' : 'p',
        unit: 'mm',
        format: [paperW, paperH]
      });

      for (let p = 0; p < totalPages; p++) {
        if (p > 0) pdf.addPage([paperW, paperH], paperW > paperH ? 'l' : 'p');
        const pageStudents = students.slice(p * cardsPerPage, (p + 1) * cardsPerPage);

        // Container capture element
        const captureContainer = document.createElement('div');
        captureContainer.style.position = 'fixed';
        captureContainer.style.top = '0';
        captureContainer.style.left = '0';
        captureContainer.style.width = `${paperW}mm`;
        captureContainer.style.height = `${paperH}mm`;
        captureContainer.style.backgroundColor = '#ffffff';
        captureContainer.style.zIndex = '-99999';
        captureContainer.style.overflow = 'hidden';

        pageStudents.forEach((student, idx) => {
          const colIdx = idx % cols;
          const rowIdx = Math.floor(idx / cols);
          const posX = computedMarginLeft + colIdx * (cardDesign.widthMm + gapXMm);
          const posY = computedMarginTop + rowIdx * (cardDesign.heightMm + gapYMm);

          const cardDiv = document.createElement('div');
          cardDiv.style.position = 'absolute';
          cardDiv.style.left = `${posX}mm`;
          cardDiv.style.top = `${posY}mm`;
          cardDiv.style.width = `${cardDesign.widthMm}mm`;
          cardDiv.style.height = `${cardDesign.heightMm}mm`;
          cardDiv.style.overflow = 'hidden';
          cardDiv.style.boxSizing = 'border-box';
          cardDiv.style.background =
            cardDesign.background.type === 'color'
              ? cardDesign.background.color
              : cardDesign.background.type === 'gradient'
              ? cardDesign.background.gradient
              : '#0f172a';

          if (cardDesign.background.type === 'image' && cardDesign.background.image) {
            const bgImg = document.createElement('img');
            bgImg.src = cardDesign.background.image;
            bgImg.style.position = 'absolute';
            bgImg.style.inset = '0';
            bgImg.style.width = '100%';
            bgImg.style.height = '100%';
            bgImg.style.objectFit = cardDesign.background.fit || 'cover';
            cardDiv.appendChild(bgImg);
          }

          cardDesign.elements.forEach((el) => {
            const elDiv = document.createElement('div');
            elDiv.style.position = 'absolute';
            elDiv.style.left = `${(el.x / 3.78).toFixed(2)}mm`;
            elDiv.style.top = `${(el.y / 3.78).toFixed(2)}mm`;
            if (el.width) elDiv.style.width = `${(el.width / 3.78).toFixed(2)}mm`;
            if (el.height) elDiv.style.height = `${(el.height / 3.78).toFixed(2)}mm`;
            if (el.zIndex) elDiv.style.zIndex = el.zIndex;

            if (el.type === 'shape') {
              elDiv.style.backgroundColor = el.fill;
              elDiv.style.opacity = (el.opacity || 100) / 100;
              if (el.borderRadius) elDiv.style.borderRadius = `${(el.borderRadius / 3.78).toFixed(2)}mm`;
            } else if (el.type === 'text' || el.type === 'placeholder') {
              elDiv.style.fontSize = `${(el.fontSize * 0.75).toFixed(2)}pt`;
              elDiv.style.fontWeight = el.fontWeight || 'normal';
              elDiv.style.fontFamily = el.fontFamily || 'sans-serif';
              elDiv.style.color = el.color || '#ffffff';
              elDiv.style.textAlign = el.textAlign || 'left';
              elDiv.innerText = renderPlaceholderText(el.content, student);
            } else if (el.type === 'photo') {
              elDiv.style.backgroundColor = '#1e293b';
              elDiv.style.border = `${el.borderWidth || 1}px solid ${el.borderColor || '#3b82f6'}`;
              elDiv.style.borderRadius = '2mm';
              elDiv.style.display = 'flex';
              elDiv.style.alignItems = 'center';
              elDiv.style.justifyContent = 'center';
              elDiv.style.color = '#94a3b8';
              elDiv.style.fontSize = '8pt';
              elDiv.style.fontWeight = 'bold';
              elDiv.innerText = 'FOTO';
            } else if (el.type === 'image') {
              const img = document.createElement('img');
              img.src = el.src;
              img.style.width = '100%';
              img.style.height = '100%';
              img.style.objectFit = 'contain';
              if (el.opacity) img.style.opacity = el.opacity / 100;
              elDiv.appendChild(img);
            } else if (el.type === 'qrcode') {
              elDiv.style.backgroundColor = '#ffffff';
              elDiv.style.padding = '1mm';
              elDiv.style.borderRadius = '1mm';
              elDiv.style.display = 'flex';
              elDiv.style.alignItems = 'center';
              elDiv.style.justifyContent = 'center';

              const qrSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
              qrSvg.setAttribute('viewBox', '0 0 24 24');
              qrSvg.setAttribute('width', '100%');
              qrSvg.setAttribute('height', '100%');
              qrSvg.setAttribute('fill', 'none');
              qrSvg.setAttribute('stroke', '#0f172a');
              qrSvg.setAttribute('stroke-width', '2');
              qrSvg.innerHTML =
                '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/>';
              elDiv.appendChild(qrSvg);
            }

            cardDiv.appendChild(elDiv);
          });

          // Crop Marks
          if (showCropMarks) {
            const cropStyle = 'position:absolute; background:#64748b; z-index:9999;';
            const markLen = '3mm';

            const topLeftH = document.createElement('div');
            topLeftH.style.cssText = `${cropStyle} left:-${markLen}; top:0; width:${markLen}; height:0.2mm;`;
            cardDiv.appendChild(topLeftH);

            const topLeftV = document.createElement('div');
            topLeftV.style.cssText = `${cropStyle} left:0; top:-${markLen}; width:0.2mm; height:${markLen};`;
            cardDiv.appendChild(topLeftV);
          }

          captureContainer.appendChild(cardDiv);
        });

        document.body.appendChild(captureContainer);
        const canvas = await window.html2canvas(captureContainer, { scale: 2, useCORS: true, logging: false });
        document.body.removeChild(captureContainer);

        const imgData = canvas.toDataURL('image/jpeg', 0.98);
        pdf.addImage(imgData, 'JPEG', 0, 0, paperW, paperH);
      }

      pdf.save(`KartuPelajarMassal_${Date.now()}.pdf`);
      addNotification('File PDF Siap Cetak berhasil diunduh!', 'success');
    } catch (err) {
      console.error(err);
      addNotification('Gagal mengunduh PDF. Pastikan gambar valid.', 'error');
    } finally {
      setIsExporting(false);
    }
  };

  return (
    <div className="p-8 max-w-7xl mx-auto space-y-8 animate-fade-in">
      {/* HEADER & ACTION BUTTONS */}
      <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 className={`text-2xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>
            Pengaturan & Live Preview Cetak
          </h2>
          <p className={`text-xs ${isDarkMode ? 'text-slate-400' : 'text-slate-500'}`}>
            Atur tata letak posisi kartu, margin kertas, serta jarak per kartu secara riil sebelum dicetak.
          </p>
        </div>
        <div className="flex items-center gap-3">
          <button
            onClick={handleDirectPrint}
            className="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-lg shadow-blue-600/20 flex items-center gap-2 transition-all"
          >
            <Printer className="w-4 h-4" />
            Cetak Langsung (Print)
          </button>
          <button
            onClick={exportPDF}
            disabled={isExporting}
            className="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/20 flex items-center gap-2 transition-all disabled:opacity-50"
          >
            <FileDown className="w-4 h-4" />
            {isExporting ? 'Mencetak PDF...' : 'Download PDF Siap Cetak'}
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* LEFT CONTROL PANEL */}
        <div
          className={`lg:col-span-5 p-6 rounded-2xl border space-y-6 ${
            isDarkMode ? 'bg-slate-950 border-slate-800' : 'bg-white border-slate-200 shadow-sm'
          }`}
        >
          {/* 1. KERTAS SETUP */}
          <div>
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">1. Pilihan Ukuran Kertas</h3>
            <div className="grid grid-cols-3 gap-2">
              <button
                onClick={() => setPaperSize('a4')}
                className={`py-2 px-3 rounded-xl border text-xs font-semibold transition-all ${
                  paperSize === 'a4'
                    ? 'bg-blue-600 border-blue-500 text-white'
                    : isDarkMode
                    ? 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'
                    : 'bg-slate-50 border-slate-200 text-slate-600'
                }`}
              >
                A4 (210×297)
              </button>
              <button
                onClick={() => setPaperSize('f4')}
                className={`py-2 px-3 rounded-xl border text-xs font-semibold transition-all ${
                  paperSize === 'f4'
                    ? 'bg-blue-600 border-blue-500 text-white'
                    : isDarkMode
                    ? 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'
                    : 'bg-slate-50 border-slate-200 text-slate-600'
                }`}
              >
                F4 (215×330)
              </button>
              <button
                onClick={() => setPaperSize('custom')}
                className={`py-2 px-3 rounded-xl border text-xs font-semibold transition-all ${
                  paperSize === 'custom'
                    ? 'bg-blue-600 border-blue-500 text-white'
                    : isDarkMode
                    ? 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200'
                    : 'bg-slate-50 border-slate-200 text-slate-600'
                }`}
              >
                Custom (mm)
              </button>
            </div>

            {paperSize === 'custom' && (
              <div className="grid grid-cols-2 gap-3 mt-3 animate-fade-in">
                <div>
                  <label className="text-[11px] text-slate-400 block mb-1">Lebar Kertas (mm)</label>
                  <input
                    type="number"
                    value={customWidthMm}
                    onChange={(e) => setCustomWidthMm(Number(e.target.value))}
                    className={`w-full p-2 rounded-xl text-xs border outline-none ${
                      isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                    }`}
                  />
                </div>
                <div>
                  <label className="text-[11px] text-slate-400 block mb-1">Tinggi Kertas (mm)</label>
                  <input
                    type="number"
                    value={customHeightMm}
                    onChange={(e) => setCustomHeightMm(Number(e.target.value))}
                    className={`w-full p-2 rounded-xl text-xs border outline-none ${
                      isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                    }`}
                  />
                </div>
              </div>
            )}
          </div>

          {/* 2. GRID & SPACING */}
          <div>
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              2. Jumlah Kartu per Lembar
            </h3>
            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Jumlah Kolom (Cards/Row)</label>
                <input
                  type="number"
                  min="1"
                  max="5"
                  value={cols}
                  onChange={(e) => setCols(Math.max(1, Number(e.target.value)))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Jumlah Baris (Cards/Column)</label>
                <input
                  type="number"
                  min="1"
                  max="10"
                  value={rows}
                  onChange={(e) => setRows(Math.max(1, Number(e.target.value)))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
            </div>
          </div>

          {/* 3. MARGIN & GAP SPACING */}
          <div>
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              3. Margin & Jarak Per Kartu (mm)
            </h3>
            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Margin Atas (mm)</label>
                <input
                  type="number"
                  value={marginTopMm}
                  onChange={(e) => setMarginTopMm(Number(e.target.value))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Margin Samping (mm)</label>
                <input
                  type="number"
                  value={marginLeftMm}
                  onChange={(e) => setMarginLeftMm(Number(e.target.value))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Gap Horizontal (Gap X mm)</label>
                <input
                  type="number"
                  value={gapXMm}
                  onChange={(e) => setGapXMm(Number(e.target.value))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Gap Vertikal (Gap Y mm)</label>
                <input
                  type="number"
                  value={gapYMm}
                  onChange={(e) => setGapYMm(Number(e.target.value))}
                  className={`w-full p-2 rounded-xl text-xs border outline-none ${
                    isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                  }`}
                />
              </div>
            </div>
          </div>

          {/* 4. DRAG / SHIFT POSITION CONTROL */}
          <div>
            <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              4. Perataan & Geser Posisi Kartu
            </h3>
            <div className="space-y-3">
              <div className="grid grid-cols-2 gap-2">
                <button
                  onClick={() => setGridAlign('left')}
                  className={`py-2 px-3 rounded-xl border text-xs font-semibold ${
                    gridAlign === 'left'
                      ? 'bg-blue-600 border-blue-500 text-white'
                      : isDarkMode
                      ? 'bg-slate-900 border-slate-800 text-slate-400'
                      : 'bg-slate-50 border-slate-200 text-slate-600'
                  }`}
                >
                  Rata Kiri Margin
                </button>
                <button
                  onClick={() => setGridAlign('center')}
                  className={`py-2 px-3 rounded-xl border text-xs font-semibold ${
                    gridAlign === 'center'
                      ? 'bg-blue-600 border-blue-500 text-white'
                      : isDarkMode
                      ? 'bg-slate-900 border-slate-800 text-slate-400'
                      : 'bg-slate-50 border-slate-200 text-slate-600'
                  }`}
                >
                  Presisi Tengah (Center)
                </button>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-[11px] text-slate-400 block mb-1">Geser Offset X (+/- mm)</label>
                  <input
                    type="number"
                    value={offsetX}
                    onChange={(e) => setOffsetX(Number(e.target.value))}
                    className={`w-full p-2 rounded-xl text-xs border outline-none ${
                      isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                    }`}
                  />
                </div>
                <div>
                  <label className="text-[11px] text-slate-400 block mb-1">Geser Offset Y (+/- mm)</label>
                  <input
                    type="number"
                    value={offsetY}
                    onChange={(e) => setOffsetY(Number(e.target.value))}
                    className={`w-full p-2 rounded-xl text-xs border outline-none ${
                      isDarkMode ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-slate-200'
                    }`}
                  />
                </div>
              </div>

              <label className="flex items-center gap-2 cursor-pointer pt-1 text-xs">
                <input
                  type="checkbox"
                  checked={showCropMarks}
                  onChange={(e) => setShowCropMarks(e.target.checked)}
                  className="rounded text-blue-600"
                />
                <span>Tampilkan Garis Potong (Crop Marks)</span>
              </label>
            </div>
          </div>
        </div>

        {/* RIGHT LIVE PREVIEW SCREEN */}
        <div className="lg:col-span-7 flex flex-col items-center space-y-4">
          <div className="flex items-center justify-between w-full max-w-lg px-2">
            <span className="text-xs font-bold text-slate-400">
              Live Preview Lembar {activePreviewPage + 1} / {totalPages}
            </span>
            <div className="flex items-center gap-2">
              <button
                disabled={activePreviewPage === 0}
                onClick={() => setActivePreviewPage((p) => p - 1)}
                className="px-3 py-1 rounded-lg border border-slate-800 text-xs font-semibold disabled:opacity-40"
              >
                Hal. Prev
              </button>
              <button
                disabled={activePreviewPage >= totalPages - 1}
                onClick={() => setActivePreviewPage((p) => p + 1)}
                className="px-3 py-1 rounded-lg border border-slate-800 text-xs font-semibold disabled:opacity-40"
              >
                Hal. Next
              </button>
            </div>
          </div>

          {/* REAL PAPER PREVIEW DISPLAY */}
          <div className="overflow-auto max-w-full p-4 bg-slate-900/60 rounded-3xl border border-slate-800 flex justify-center">
            <div
              className="relative bg-white text-slate-900 shadow-2xl transition-all border border-slate-300"
              style={{
                width: `${currentPaper.w * previewScale}px`,
                height: `${currentPaper.h * previewScale}px`
              }}
            >
              {currentPageStudents.map((student, idx) => {
                const colIdx = idx % cols;
                const rowIdx = Math.floor(idx / cols);
                const posX = computedMarginLeft + colIdx * (cardDesign.widthMm + gapXMm);
                const posY = computedMarginTop + rowIdx * (cardDesign.heightMm + gapYMm);

                return (
                  <div
                    key={student.id}
                    className="absolute shadow-sm border border-slate-300 overflow-hidden"
                    style={{
                      left: `${posX * previewScale}px`,
                      top: `${posY * previewScale}px`,
                      width: `${cardDesign.widthMm * previewScale}px`,
                      height: `${cardDesign.heightMm * previewScale}px`,
                      background:
                        cardDesign.background.type === 'color'
                          ? cardDesign.background.color
                          : cardDesign.background.type === 'gradient'
                          ? cardDesign.background.gradient
                          : '#0f172a'
                    }}
                  >
                    {cardDesign.background.type === 'image' && cardDesign.background.image && (
                      <img
                        src={cardDesign.background.image}
                        alt="bg"
                        className="absolute inset-0 w-full h-full object-cover pointer-events-none"
                      />
                    )}

                    {cardDesign.elements.map((el) => {
                      const scaleFactor = (cardDesign.widthMm * previewScale) / (cardDesign.widthMm * 3.78);
                      return (
                        <div
                          key={el.id}
                          className="absolute pointer-events-none"
                          style={{
                            left: `${el.x * scaleFactor}px`,
                            top: `${el.y * scaleFactor}px`,
                            width: el.width ? `${el.width * scaleFactor}px` : undefined,
                            height: el.height ? `${el.height * scaleFactor}px` : undefined,
                            zIndex: el.zIndex || 1
                          }}
                        >
                          {el.type === 'shape' && (
                            <div
                              style={{
                                width: '100%',
                                height: '100%',
                                backgroundColor: el.fill,
                                opacity: (el.opacity || 100) / 100,
                                borderRadius: `${(el.borderRadius || 0) * scaleFactor}px`
                              }}
                            />
                          )}
                          {(el.type === 'text' || el.type === 'placeholder') && (
                            <div
                              style={{
                                fontSize: `${el.fontSize * scaleFactor}px`,
                                fontWeight: el.fontWeight,
                                fontFamily: el.fontFamily,
                                color: el.color,
                                textAlign: el.textAlign
                              }}
                            >
                              {renderPlaceholderText(el.content, student)}
                            </div>
                          )}
                          {el.type === 'photo' && (
                            <div
                              className="bg-slate-800 flex items-center justify-center text-[8px] text-slate-400 font-bold border border-blue-500/40"
                              style={{ width: '100%', height: '100%', borderRadius: '2px' }}
                            >
                              FOTO
                            </div>
                          )}
                          {el.type === 'image' && (
                            <img
                              src={el.src}
                              alt={el.name}
                              style={{ width: '100%', height: '100%', objectFit: 'contain' }}
                            />
                          )}
                          {el.type === 'qrcode' && (
                            <div
                              className="bg-white p-0.5 rounded flex items-center justify-center"
                              style={{ width: '100%', height: '100%' }}
                            >
                              <QrCode className="w-full h-full text-slate-900" />
                            </div>
                          )}
                        </div>
                      );
                    })}

                    {showCropMarks && (
                      <>
                        <div className="absolute top-0 left-0 w-2 h-[0.5px] bg-slate-500" />
                        <div className="absolute top-0 left-0 w-[0.5px] h-2 bg-slate-500" />
                      </>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
