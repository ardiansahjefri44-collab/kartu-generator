// EXCEL IMPORT VIEW COMPONENT
function ExcelImportView({ students, setStudents, addNotification, setActiveTab, isDarkMode }) {
  const handleFileUpload = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (evt) => {
      try {
        const data = new Uint8Array(evt.target.result);
        const workbook = window.XLSX.read(data, { type: 'array' });
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        const json = window.XLSX.utils.sheet_to_json(worksheet);

        const mapped = json.map((row, idx) => ({
          id: `st-${Date.now()}-${idx}-${Math.random().toString(36).substring(2, 7)}`,
          nama: String(row.Nama || row.NAMA || row['Nama Siswa'] || 'SISWA ' + (idx + 1)).toUpperCase(),
          kelas: String(row.Kelas || row.KELAS || 'XII MIPA 1'),
          ruang: String(row.Ruang || row.RUANG || row['Nomor Ruang'] || '01'),
          noPeserta: String(row.Peserta || row['No Peserta'] || row['Nomor Peserta'] || `2026-${1000 + idx}`),
          photo: null
        }));

        setStudents(mapped);
        addNotification(`Berhasil mengimpor ${mapped.length} data siswa!`, 'success');
        setActiveTab('data');
      } catch (err) {
        addNotification('Gagal membaca file Excel! Pastikan format sesuai.', 'error');
      }
    };
    reader.readAsArrayBuffer(file);
  };

  return (
    <div className="p-8 max-w-4xl mx-auto space-y-8 animate-fade-in">
      <div className="text-center space-y-2">
        <h2 className={`text-2xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>Import Data Siswa dari Excel</h2>
        <p className={`text-xs ${isDarkMode ? 'text-slate-400' : 'text-slate-600'}`}>
          Unggah file Excel (.xlsx / .xls) yang berisi data Nama, Kelas, Nomor Ruang, dan Nomor Peserta.
        </p>
      </div>

      <div className={`p-12 rounded-3xl border-2 border-dashed text-center space-y-4 ${isDarkMode ? 'bg-slate-950/60 border-blue-500/30' : 'bg-white border-blue-300 shadow-sm'}`}>
        <FileSpreadsheet className="w-12 h-12 text-blue-500 mx-auto animate-bounce-short" />
        <div>
          <label className="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-lg shadow-blue-600/20 cursor-pointer inline-flex items-center gap-2 transition-all">
            <Upload className="w-4 h-4" />
            Pilih File Excel Laptop (.xlsx)
            <input type="file" accept=".xlsx, .xls" className="hidden" onChange={handleFileUpload} />
          </label>
        </div>
        <p className="text-[11px] opacity-50">Dukungan format .xlsx dan .xls hingga ribuan data sekaligus.</p>
      </div>
    </div>
  );
}

// 4. STUDENT DATA TABLE VIEW WITH BULK DELETE & SELECTION
function StudentDataView({ students, setStudents, searchQuery, setSearchQuery, addNotification, isDarkMode }) {
  const [selectedIds, setSelectedIds] = useState([]);
  const [showConfirmModal, setShowConfirmModal] = useState(false);

  const filteredStudents = students.filter(
    (s) =>
      s.nama.toLowerCase().includes(searchQuery.toLowerCase()) ||
      s.noPeserta.toLowerCase().includes(searchQuery.toLowerCase()) ||
      s.kelas.toLowerCase().includes(searchQuery.toLowerCase())
  );

  const isAllSelected = filteredStudents.length > 0 && selectedIds.length === filteredStudents.length;

  const toggleSelectAll = () => {
    if (isAllSelected) {
      setSelectedIds([]);
    } else {
      setSelectedIds(filteredStudents.map((s) => s.id));
    }
  };

  const toggleSelectOne = (id) => {
    if (selectedIds.includes(id)) {
      setSelectedIds(selectedIds.filter((item) => item !== id));
    } else {
      setSelectedIds([...selectedIds, id]);
    }
  };

  const deleteSingleStudent = (id) => {
    const target = students.find((s) => s.id === id);
    setStudents(students.filter((s) => s.id !== id));
    setSelectedIds(selectedIds.filter((item) => item !== id));
    addNotification(`Data "${target?.nama || 'Siswa'}" berhasil dihapus`, 'info');
  };

  const deleteSelectedStudents = () => {
    setStudents(students.filter((s) => !selectedIds.includes(s.id)));
    addNotification(`Berhasil menghapus ${selectedIds.length} data siswa terlipih!`, 'success');
    setSelectedIds([]);
  };

  const deleteAllStudents = () => {
    setStudents([]);
    setSelectedIds([]);
    setShowConfirmModal(false);
    addNotification('Seluruh data siswa telah dikosongkan', 'info');
  };

  const addNewStudent = () => {
    const newStudent = {
      id: `st-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
      nama: 'SISWA BARU',
      kelas: 'XII MIPA 1',
      ruang: '01',
      noPeserta: `2026-${Math.floor(1000 + Math.random() * 9000)}`,
      photo: null
    };
    setStudents([newStudent, ...students]);
    addNotification('Siswa baru berhasil ditambahkan', 'success');
  };

  return (
    <div className="p-8 max-w-7xl mx-auto space-y-6">
      {/* HEADER ACTIONS */}
      <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 className={`text-2xl font-bold ${isDarkMode ? 'text-white' : 'text-slate-900'}`}>Data Pelajar ({students.length})</h2>
          <p className={`text-xs ${isDarkMode ? 'text-slate-400' : 'text-slate-500'}`}>Data tersimpan otomatis di memori internal browser (Anti-hilang saat refresh).</p>
        </div>
        <div className="flex items-center gap-2">
          {students.length > 0 && (
