export default function App() {
  const [isDarkMode, setIsDarkMode] = useState(true);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [notifications, setNotifications] = useState([]);
  const [selectedElementId, setSelectedElementId] = useState(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [previewStudentIdx, setPreviewStudentIdx] = useState(0);
  const [zoomLevel, setZoomLevel] = useState(1);
  const [isLibsReady, setIsLibsReady] = useState(false);

  // Persistence State Initializer from localStorage
  const [students, setStudents] = useState(() => {
    try {
      const saved = localStorage.getItem('kartu_pelajar_students');
      return saved ? JSON.parse(saved) : DEFAULT_STUDENTS;
    } catch {
      return DEFAULT_STUDENTS;
    }
  });

  const [cardDesign, setCardDesign] = useState(() => {
    try {
      const saved = localStorage.getItem('kartu_pelajar_design');
      return saved ? JSON.parse(saved) : DEFAULT_DESIGN;
    } catch {
      return DEFAULT_DESIGN;
    }
  });

  const [savedDesigns, setSavedDesigns] = useState(() => {
    try {
      const saved = localStorage.getItem('kartu_pelajar_templates');
      return saved ? JSON.parse(saved) : [DEFAULT_DESIGN];
    } catch {
      return [DEFAULT_DESIGN];
    }
  });

  // Auto-save changes to localStorage
  useEffect(() => {
    try {
      localStorage.setItem('kartu_pelajar_students', JSON.stringify(students));
    } catch (e) { console.error('LocalStorage error', e); }
  }, [students]);

  useEffect(() => {
    try {
      localStorage.setItem('kartu_pelajar_design', JSON.stringify(cardDesign));
    } catch (e) { console.error('LocalStorage error', e); }
  }, [cardDesign]);

  useEffect(() => {
    try {
      localStorage.setItem('kartu_pelajar_templates', JSON.stringify(savedDesigns));
    } catch (e) { console.error('LocalStorage error', e); }
  }, [savedDesigns]);

  // Auto-load external CDN libraries seamlessly
  useEffect(() => {
    const loadScript = (src) => {
      return new Promise((resolve) => {
        if (document.querySelector(`script[src="${src}"]`)) return resolve();
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        document.head.appendChild(s);
      });
    };

    Promise.all([
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'),
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'),
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js'),
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js')
    ]).then(() => {
      setIsLibsReady(true);
    });
  }, []);

  const addNotification = (text, type = 'info') => {
    const id = `notif-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`;
    setNotifications((prev) => [...prev, { id, text, type }]);
    setTimeout(() => {
      setNotifications((prev) => prev.filter((n) => n.id !== id));
    }, 4000);
  };

  const renderPlaceholderText = (text, student) => {
    if (!text || typeof text !== 'string') return '';
    const st = student || students[0] || { nama: 'Fulan', kelas: 'X-1', ruang: '01', noPeserta: '0000' };
    return text
      .replace(/\[NAMA\]/g, st.nama)
      .replace(/\[KELAS\]/g, st.kelas)
      .replace(/\[NOMOR RUANG\]/g, st.ruang)
      .replace(/\[NOMOR PESERTA\]/g, st.noPeserta);
  };

  const saveCurrentTemplate = () => {
    const existingIdx = savedDesigns.findIndex((d) => d.id === cardDesign.id);
    let updated;
    if (existingIdx >= 0) {
      updated = [...savedDesigns];
      updated[existingIdx] = cardDesign;
    } else {
      updated = [...savedDesigns, cardDesign];
    }
    setSavedDesigns(updated);
    addNotification(`Template "${cardDesign.name}" tersimpan secara permanen!`, 'success');
  };

  // Set Current Design as Permanent Custom Default
  const setAsDefaultTemplate = () => {
    try {
      localStorage.setItem('kartu_pelajar_default_template', JSON.stringify(cardDesign));
      saveCurrentTemplate();
      addNotification('Desain saat ini berhasil dijadikan Template Standar Default!', 'success');
    } catch (e) {
      addNotification('Gagal menyimpan template default', 'error');
    }
  };

  // Reset Application Data
  const resetToDefaultData = () => {
    if (window.confirm('Apakah Anda yakin ingin mereset seluruh data siswa dan desain ke pengaturan awal?')) {
      const customDefault = localStorage.getItem('kartu_pelajar_default_template');
      const baseDesign = customDefault ? JSON.parse(customDefault) : DEFAULT_DESIGN;
      
      setStudents(DEFAULT_STUDENTS);
      setCardDesign(baseDesign);
      setSavedDesigns([baseDesign]);
      localStorage.removeItem('kartu_pelajar_students');
      localStorage.removeItem('kartu_pelajar_design');
      addNotification('Data berhasil di-reset ke template standar default', 'info');
    }
  };

  return (
    <div className={`min-h-screen font-sans antialiased transition-colors duration-300 ${isDarkMode ? 'bg-slate-950 text-slate-100' : 'bg-slate-50 text-slate-800'}`}>
      {/* GLOBAL NAVBAR */}
      <header className={`sticky top-0 z-40 border-b backdrop-blur-md ${isDarkMode ? 'bg-slate-950/80 border-slate-800' : 'bg-white/80 border-slate-200'}`}>
        <div className="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/20">
              <Sparkles className="w-5 h-5" />
            </div>
            <div>
              <h1 className="font-bold text-sm tracking-wide bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
                KartuPelajarPro
              </h1>
              <p className="text-[10px] opacity-60">Generator Massal & Studio Desain</p>
            </div>
          </div>

          <nav className="hidden md:flex items-center gap-1 bg-slate-900/50 p-1 rounded-xl border border-slate-800/80">
            <NavItem label="Dashboard" icon={<LayoutDashboard className="w-4 h-4"/>} active={activeTab === 'dashboard'} onClick={() => setActiveTab('dashboard')} />
            <NavItem label="Editor Desain" icon={<Edit3 className="w-4 h-4"/>} active={activeTab === 'editor'} onClick={() => setActiveTab('editor')} />
            <NavItem label="Import Excel" icon={<FileSpreadsheet className="w-4 h-4"/>} active={activeTab === 'import'} onClick={() => setActiveTab('import')} />
            <NavItem label="Data Pelajar" icon={<Users className="w-4 h-4"/>} active={activeTab === 'data'} onClick={() => setActiveTab('data')} />
            <NavItem label="Preview Massal" icon={<Eye className="w-4 h-4"/>} active={activeTab === 'preview'} onClick={() => setActiveTab('preview')} />
            <NavItem label="Pengaturan Cetak" icon={<Printer className="w-4 h-4"/>} active={activeTab === 'print'} onClick={() => setActiveTab('print')} />
          </nav>

          <div className="flex items-center gap-2">
            <button
              onClick={() => setIsDarkMode(!isDarkMode)}
              className={`p-2 rounded-xl border transition-all ${isDarkMode ? 'bg-slate-900 border-slate-800 text-amber-400 hover:bg-slate-800' : 'bg-slate-100 border-slate-200 text-slate-700 hover:bg-slate-200'}`}
              title="Toggle Mode Terang/Gelap"
            >
              {isDarkMode ? <Sun className="w-4 h-4" /> : <Moon className="w-4 h-4" />}
            </button>
            <button
              onClick={setAsDefaultTemplate}
              className="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 flex items-center gap-1.5 transition-all"
              title="Jadikan Desain Ini Sebagai Template Default Permanen"
            >
              Set Default
            </button>
            <button
              onClick={saveCurrentTemplate}
              className="px-3 py-1.5 text-xs font-semibold rounded-xl bg-blue-600 hover:bg-blue-500 text-white flex items-center gap-1.5 shadow-md shadow-blue-600/20 transition-all"
            >
              Simpan Desain
            </button>
          </div>
        </div>
      </header>

      {/* NOTIFICATION SYSTEM */}
      <div className="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none">
        {notifications.map((n) => (
          <div
            key={n.id}
            className={`pointer-events-auto px-4 py-3 rounded-xl border shadow-xl text-xs font-medium flex items-center gap-2.5 animate-bounce-short ${
              n.type === 'success'
                ? 'bg-emerald-950/90 border-emerald-800 text-emerald-200'
                : n.type === 'error'
                ? 'bg-rose-950/90 border-rose-800 text-rose-200'
                : 'bg-blue-950/90 border-blue-800 text-blue-200'
            }`}
          >
            {n.type === 'success' && <CheckCircle className="w-4 h-4 text-emerald-400" />}
            {n.type === 'error' && <AlertTriangle className="w-4 h-4 text-rose-400" />}
            {n.type === 'info' && <Sparkles className="w-4 h-4 text-blue-400" />}
            <span>{n.text}</span>
          </div>
        ))}
      </div>

      {/* MAIN CONTAINER CONTENT VIEW */}
      <main className="pb-16">
        {activeTab === 'dashboard' && (
          <DashboardView
            studentsCount={students.length}
            savedCount={savedDesigns.length}
            setActiveTab={setActiveTab}
            isDarkMode={isDarkMode}
            resetToDefaultData={resetToDefaultData}
          />
        )}
        {activeTab === 'editor' && (
          <CardEditorView
            cardDesign={cardDesign}
            setCardDesign={setCardDesign}
            students={students}
            previewStudentIdx={previewStudentIdx}
            renderPlaceholderText={renderPlaceholderText}
            addNotification={addNotification}
            isDarkMode={isDarkMode}
          />
        )}
        {activeTab === 'import' && (
          <ExcelImportView
            students={students}
            setStudents={setStudents}
            addNotification={addNotification}
            setActiveTab={setActiveTab}
            isDarkMode={isDarkMode}
          />
        )}
        {activeTab === 'data' && (
          <StudentDataView
            students={students}
            setStudents={setStudents}
